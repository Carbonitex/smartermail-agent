<?xml version="1.0" encoding="utf-8"?>
<!-- Every package this repo uses is on nuget.org. Clearing inherited sources makes a Mac restore match
     the Docker build (whose SDK image only knows nuget.org), and the single mapped source satisfies
     central package management (otherwise NU1507 whenever a user-level config adds a second feed). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
