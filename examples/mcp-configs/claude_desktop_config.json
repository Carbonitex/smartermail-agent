{
  "mcpServers": {
    "smartermail": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "SMARTERMAIL_URL",
        "-e", "SMARTERMAIL_USER",
        "-e", "SMARTERMAIL_PASSWORD",
        "ghcr.io/carbonitex/smartermail-mcp-user:1", "--stdio"
      ],
      "env": {
        "SMARTERMAIL_URL": "https://mail.example.com",
        "SMARTERMAIL_USER": "you@example.com",
        "SMARTERMAIL_PASSWORD": "your-password"
      }
    },
    "smartermail-admin": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "SMARTERMAIL_URL",
        "-e", "SMARTERMAIL_ADMIN_USER",
        "-e", "SMARTERMAIL_ADMIN_PASSWORD",
        "-e", "SMARTERMAIL_READ_ONLY",
        "ghcr.io/carbonitex/smartermail-mcp-admin:1", "--stdio"
      ],
      "env": {
        "SMARTERMAIL_URL": "https://mail.example.com",
        "SMARTERMAIL_ADMIN_USER": "admin",
        "SMARTERMAIL_ADMIN_PASSWORD": "admin-password",
        "SMARTERMAIL_READ_ONLY": "true"
      }
    }
  }
}
