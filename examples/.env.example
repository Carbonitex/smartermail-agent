# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.
# Wrap any value containing $ in single quotes ('like$this'): Compose expands $ in unquoted values.
# A service whose settings are missing exits with a message saying which (docker compose logs <service>).

# --- SmarterMail server (both MCP servers) -------------------------------------------------------
SMARTERMAIL_URL=https://mail.example.com

# --- smartermail-mcp-user: one mailbox -----------------------------------------------------------
# Use a dedicated account without two-step verification (the server cannot answer a 2FA prompt).
SMARTERMAIL_USER=assistant@example.com
SMARTERMAIL_PASSWORD='change-me'
# Key MCP clients send as "Authorization: Bearer ...". Generate with: openssl rand -hex 32
USER_MCP_API_KEY=
# true (default) = read tools only; false = also send, move, delete, change settings
USER_MCP_READ_ONLY=true
# auto (default) = domain_* tools only when the account is a domain admin; true / false to force
SMARTERMAIL_DOMAIN_TOOLS=auto

# --- smartermail-mcp-admin: one system admin -----------------------------------------------------
SMARTERMAIL_ADMIN_USER=admin
SMARTERMAIL_ADMIN_PASSWORD='change-me'
# Generate with: openssl rand -hex 32   (anyone with this key can act as the admin)
ADMIN_MCP_API_KEY=
# true (default) = 29 read tools; false = all 58, including deletes
ADMIN_MCP_READ_ONLY=true

# --- smartermail-agent: the browser chat ---------------------------------------------------------
# Enables "Remember me on this device". Generate once with: openssl rand -base64 32
# Changing it signs every remembered browser out.
RESUME_KEY=
# URL prefix when your reverse proxy serves it under a path, e.g. /mail-agent
AGENT_PATH_BASE=/
# IP or CIDR your reverse proxy connects from, e.g. 172.18.0.0/16 (see docs/agent.md)
AGENT_TRUSTED_PROXIES=
